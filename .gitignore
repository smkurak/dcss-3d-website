node_modules/
dist/
.astro/

# Исходники медиа: гифка на 74 МБ и PNG по 4–5 МБ в git не нужны —
# история репозитория раздувается навсегда, а на сайт всё равно едут
# пережатые файлы из public/media (их коммитим).
# Оригиналы держим локально / в облаке / в git-lfs, если очень надо.
media-src/

# Тяжёлым исходникам в src/ не место: они лежат в media-src/.
# Правило страхует от случайного перетаскивания файла не в ту папку.
/src/*.gif

# Папка fonts/ пришла из Unity целиком. Сайту нужен ровно один файл —
# исходник для scripts/build-fonts.py. Атласы TextMeshPro (*.asset, ~9 МБ),
# .meta-файлы и неиспользуемые гарнитуры в репозитории сайта не нужны:
# они относятся к Unity-проекту и живут в нём.
/fonts/*
!/fonts/IosevkaCharonMono-Regular.ttf

# Windows / редакторы
Thumbs.db
.DS_Store
*.log
