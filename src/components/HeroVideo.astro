---
import Clip from './Clip.astro';

/**
 * Первый экран. Вся механика — в Clip.astro, здесь только имя клипа:
 * герой и клипы внутри записей devlog устроены одинаково, и держать
 * для них два разных компонента значило бы чинить всё дважды.
 */

interface Props {
  /** Что происходит на записи — уходит в aria-label и в alt запасной картинки. */
  label: string;
}

const { label } = Astro.props;
---

<Clip name="hero" label={label} />
