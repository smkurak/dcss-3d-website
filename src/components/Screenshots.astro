---
import media from '../data/media.json';
import Shot from './Shot.astro';
import { t, type Lang } from '../i18n';

/**
 * Скриншоты. Размеры берутся из src/data/media.json — его пишет
 * scripts/build-media.mjs, поэтому width/height всегда настоящие
 * и картинки не дёргают вёрстку при загрузке.
 *
 * Подписи и alt переведены и лежат в src/i18n/ui.ts, ключ — id снимка.
 * Названия из игры (Foxfire, Dungeon:1) внутри них не переводятся.
 *
 * Вёрстка одной панели — в Shot.astro.
 */

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);

// Ключи словаря — те же id, что в манифесте. Если снимок появится в
// media.json раньше, чем подпись к нему, страница не упадёт: alt останется
// пустым, а подпись — незаполненной, и это будет видно при вычитке.
const shots = media.shots;
const copy = s.shots as Record<string, { caption: string; alt: string } | undefined>;

const [lead, ...rest] = shots;
---

<section aria-labelledby="shots-heading" class="mx-auto max-w-5xl px-5 sm:px-8">
  <h2 id="shots-heading" class="sr-only">{s.home.screenshotsHeading}</h2>

  <div class="flex flex-col gap-4">
    <Shot
      shot={lead}
      alt={copy[lead.id]?.alt ?? ''}
      caption={copy[lead.id]?.caption ?? ''}
      openLabel={s.home.openFullSize}
      fallbackWidth={1600}
      sizes="(min-width: 1024px) 960px, 100vw"
    />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        rest.map((shot) => (
          <Shot
            shot={shot}
            alt={copy[shot.id]?.alt ?? ''}
            caption={copy[shot.id]?.caption ?? ''}
            openLabel={s.home.openFullSize}
            fallbackWidth={800}
            sizes="(min-width: 1024px) 472px, (min-width: 640px) 50vw, 100vw"
          />
        ))
      }
    </div>
  </div>
</section>
