---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { defaultLang, localePath, t } from '../i18n';

/**
 * Страница «не найдено». GitHub Pages сам отдаёт 404.html из корня
 * опубликованного сайта, поэтому файл обязан лежать в pages/ — иначе
 * на любой опечатке в адресе покажется чужая страница GitHub.
 *
 * Страница одна и английская: Pages отдаёт единственный 404.html на весь
 * сайт и не знает, с какого языка пришёл посетитель. Переключатель в шапке
 * при этом работает — с него можно уйти на главную нужного языка.
 *
 * Текст — тем же голосом, каким говорит игра: строка лога и адрес.
 */
const lang = defaultLang;
const s = t(lang);
---

<Base
  lang={lang}
  path="/"
  hasTranslations={false}
  title={`${s.notFound.title} — ${site.name}`}
  description={s.notFound.body}
>
  <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="font-mono text-xs text-warning">404</p>

    <h1
      class="mt-2 text-[clamp(1.6rem,1.2rem+1.6vw,2.25rem)] font-semibold tracking-tight"
    >
      {s.notFound.heading}
    </h1>

    <p class="mt-4 max-w-[54ch] text-[1.0625rem] leading-relaxed text-ink-dim">
      {s.notFound.body}
    </p>

    <p class="mt-6">
      <a
        href={localePath(lang, '/')}
        class="inline-flex min-h-11 items-center rounded border border-rule bg-panel px-4 text-sm text-ink transition-colors hover:border-ink-dim"
      >
        {s.notFound.home}
      </a>
    </p>
  </section>
</Base>
