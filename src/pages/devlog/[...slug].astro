---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
import { defaultLang, localePath, t } from '../../i18n';
import { getPosts, isoDate, type Post } from '../../lib/devlog';

// Записи существуют только по-английски: переводить содержательные тексты
// на четыре языка — отдельная работа на каждый пост и обязательство держать
// версии в согласии. Обвязка страницы поэтому тоже английская.
const lang = defaultLang;
const s = t(lang);

/**
 * Страница поста. Адрес берётся из имени файла: `render-distance.md`
 * -> /devlog/render-distance/
 *
 * [...slug] со звёздочкой, а не [slug]: так адрес переживёт вложенные
 * папки внутри content/devlog, если посты захочется разложить по годам.
 */
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

{/* path='/devlog', а не адрес самой записи: у записи нет переводов, и
    переключатель языка уводит на список devlog на выбранном языке —
    иначе читатель попадает в языковой тупик. hasTranslations=false, чтобы
    не объявлять hreflang на адреса, которых не существует. */}
<Base
  lang={lang}
  path="/devlog"
  hasTranslations={false}
  title={`${post.data.title} — ${site.name} devlog`}
  description={post.data.summary}
>
  <article class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="max-w-[62ch]">
      <time
        datetime={isoDate(post.data.date)}
        class="font-mono text-xs text-ink-dim"
      >
        {isoDate(post.data.date)}
      </time>

      <h1
        class="mt-2 text-[clamp(1.6rem,1.2rem+1.6vw,2.25rem)] font-semibold leading-tight tracking-tight text-balance"
      >
        {post.data.title}
      </h1>

      <div class="prose mt-8">
        <Content />
      </div>

      <p class="mt-14 border-t border-rule/30 pt-6">
        <a
          href={localePath(lang, '/devlog')}
          class="font-mono text-sm text-ink-dim transition-colors hover:text-ink"
        >
          ← {s.devlog.back}
        </a>
      </p>
    </div>
  </article>
</Base>
