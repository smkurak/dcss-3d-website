---
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Screenshots from '../components/Screenshots.astro';
import { specs } from '../config';

const toneClass = {
  none: 'text-ink',
  hp: 'text-hp',
  warning: 'text-warning',
} as const;
import { href } from '../lib/paths';

/**
 * Три абзаца — пересказ раздела 1 проектной библии (docs/DCSS-3D-BIBLE.md).
 * Порядок оттуда же: что берём, что делаем сами, по чему судим результат.
 */
const sections = [
  {
    n: '01',
    title: 'What comes from the original',
    body:
      'All the game logic stays upstream: mechanics, balance, dungeon generation, ' +
      'monster behaviour, the text. Twenty years of work that one person cannot ' +
      'reproduce, and no reason to try. Nothing here forks the game or changes how ' +
      'it plays.',
  },
  {
    n: '02',
    title: 'What is built here',
    body:
      'Only the renderer and the interface — the part the game lacks, and the part ' +
      'that turns new players away before they reach anything else. The principle is ' +
      'asymmetry of contribution: not rewriting the game, but attaching to it the one ' +
      'piece it is missing. It is a hobby project and competes with nothing.',
  },
  {
    n: '03',
    title: 'The test every change has to pass',
    body:
      'Is it still as readable as the original? DCSS is information-dense — one glance ' +
      'tells you where everyone stands, what is visible, what is only remembered, and ' +
      'what is dangerous. A 3D picture easily carries less than a grid of glyphs. If it ' +
      'looks better and plays worse, it has failed at the one thing it was for.',
  },
];
---

<Base>
  {/* --- Первый экран ------------------------------------------------------ */}
  <section class="mx-auto max-w-5xl px-5 pb-12 pt-12 sm:px-8 sm:pb-16 sm:pt-20">
    <h1
      class="max-w-[19ch] text-[clamp(1.9rem,1.25rem+2.7vw,3.1rem)] font-semibold leading-[1.1] tracking-tight text-balance"
    >
      A 3D client for Dungeon Crawl Stone Soup
    </h1>

    <p class="mt-5 max-w-[54ch] text-[1.0625rem] leading-relaxed text-ink-dim">
      A Unity renderer and interface on top of the original game. The rules stay
      exactly where they are.
    </p>

    {/*
      Кнопки GitHub здесь нет намеренно. На лендинге про 3D-клиент «GitHub»
      читается как «исходники клиента», а вёл бы в репозиторий этого сайта —
      человек жмёт первой ссылкой и попадает не туда. Исходники клиента пока
      закрыты; факт об этом стоит в блоке характеристик ниже, моноширинным,
      вместе с остальной техникой. Появится репозиторий клиента — кнопка
      вернётся сюда и будет вести куда обещает.

      Ссылка на исходники самого сайта осталась в подвале и там подписана.
    */}
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a
        href={href('/devlog')}
        class="inline-flex min-h-11 items-center rounded border border-rule bg-panel px-4 text-sm text-ink transition-colors hover:border-ink-dim"
      >
        Devlog
      </a>
    </div>

    <div class="mt-10 sm:mt-12">
      <HeroVideo
        label="Gameplay recording: the camera moves over a stone dungeon level while the character panel, minimap and message log update alongside."
      />
    </div>
  </section>

  {/* --- Три абзаца -------------------------------------------------------- */}
  <section
    aria-label="About the project"
    class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16"
  >
    <div class="flex max-w-[62ch] flex-col gap-10 sm:gap-12">
      {
        sections.map((s) => (
          <div>
            {/* Раньше стояло text-rule — цвет рамки на фоне окна даёт 2.3:1
                при норме 4.5:1, номера читались как грязь на экране. */}
            <p class="font-mono text-xs text-ink-dim">{s.n}</p>
            <h2 class="mt-2 text-lg font-semibold tracking-tight text-ink sm:text-xl">
              {s.title}
            </h2>
            <p class="mt-3 text-[1.0625rem] leading-[1.75] text-ink-dim">{s.body}</p>
          </div>
        ))
      }
    </div>

    {/*
      Технические факты — моноширинным, по правилу из style-guide.md.

      Свёрстано панелью в обводке: ровно так в клиенте выглядит блок
      характеристик — фон панели, рамка в 1px, две колонки «ключ: значение».
      Сайт и клиент должны выглядеть одной вещью, а не двумя.

      Ширина в rem, а не 62ch как у текста рядом. `ch` считается по шрифту
      САМОГО элемента, а здесь он моноширинный и узкий: те же 62ch дают
      ~434px вместо ~600px у Manrope. Из-за этого «upstream, unmodified»
      и переносилось посреди строки. 38rem — ширина колонки текста слева.

      Две колонки включаются с md, а не с sm: на 640px их ширины не хватает.
    */}
    <dl
      class="mt-14 grid max-w-[38rem] grid-cols-1 gap-x-10 rounded border border-rule/60 bg-panel px-5 py-3 font-mono text-sm sm:mt-16 md:grid-cols-2"
    >
      {
        specs.map((spec) => (
          <div class="flex gap-4 py-2">
            <dt class="w-24 shrink-0 text-ink-dim">{spec.key}</dt>
            {/* Классы перечислены строками, а не собраны из tone: Tailwind
                ищет их в исходнике и вычисленное имя вроде `text-${tone}`
                не увидит — правило вообще не попадёт в CSS. */}
            <dd class={toneClass[spec.tone ?? 'none']}>{spec.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* --- Скриншоты --------------------------------------------------------- */}
  <Screenshots />
</Base>
