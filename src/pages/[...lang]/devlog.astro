---
import Base from '../../layouts/Base.astro';
import { defaultLang, langCodes, localePath, t, type Lang } from '../../i18n';
import { asset } from '../../lib/paths';
import { getPosts, isoDate } from '../../lib/devlog';

/**
 * Список записей devlog на четырёх языках.
 *
 * Переведена только обвязка — заголовок, вводка, пустое состояние. Сами
 * записи английские, и на локализованных страницах об этом сказано прямо:
 * читатель должен узнать это до клика, а не после.
 */
export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const posts = await getPosts();
---

<Base lang={lang} path="/devlog" title={`${s.devlog.title} — DCSS 3D`} description={s.devlog.description}>
  <section class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <h1
      class="text-[clamp(1.6rem,1.2rem+1.6vw,2.25rem)] font-semibold tracking-tight"
    >
      {s.devlog.title}
    </h1>
    <p class="mt-4 max-w-[54ch] text-[1.0625rem] leading-relaxed text-ink-dim">
      {s.devlog.lead}
    </p>

    {
      lang !== defaultLang && (
        <p class="mt-3 font-mono text-xs text-ink-dim">{s.devlog.englishOnly}</p>
      )
    }

    {
      posts.length === 0 ? (
        <p class="mt-10 font-mono text-sm text-ink-dim">{s.devlog.empty}</p>
      ) : (
        <ul class="mt-12 max-w-[62ch]">
          {posts.map((post) => (
            <li class="border-t border-rule/30 py-6 first:border-t-0 first:pt-0">
              <article>
                {/* Дата машинная, поэтому моноширинная. <time> — чтобы её
                    понимали не только глазами. */}
                <time
                  datetime={isoDate(post.data.date)}
                  class="font-mono text-xs text-ink-dim"
                >
                  {isoDate(post.data.date)}
                </time>

                <h2 class="mt-2 text-lg font-semibold tracking-tight sm:text-xl">
                  {/* Записи живут только по-английски — ссылка всегда
                      на адрес без языкового префикса. */}
                  <a
                    href={localePath(defaultLang, `/devlog/${post.id}`)}
                    class="text-ink transition-colors hover:text-name"
                  >
                    {post.data.title}
                  </a>
                </h2>

                <p class="mt-2 leading-relaxed text-ink-dim">{post.data.summary}</p>

                {import.meta.env.DEV && post.data.draft && (
                  <p class="mt-2 font-mono text-xs text-warning">{s.devlog.draftNote}</p>
                )}
              </article>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-12">
      <a
        href={asset('rss.xml')}
        class="font-mono text-sm text-ink-dim underline decoration-rule underline-offset-4 transition-colors hover:text-ink"
      >
        rss.xml
      </a>
    </p>
  </section>
</Base>
