---
import Base from '../../layouts/Base.astro';
import { defaultLang, langCodes, t, type Lang } from '../../i18n';

/**
 * Источники и инструменты.
 *
 * Для этого проекта страница не формальность: ключевой принцип из библии —
 * асимметрия вклада. Игра целиком чужая, своё здесь только рендер и интерфейс.
 *
 * Переводятся заголовки, вводки и пояснения. НЕ переводятся имена собственные
 * и строки лицензий (`meta`): «GPL v2 or later», «SIL OFL 1.1» и копирайты —
 * это юридические формулировки, их перевод не имеет силы и только путает.
 */
export function getStaticPaths() {
  return langCodes.map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);

interface Item {
  name: string;
  url: string;
  meta?: string;
  note?: string;
}

const groups: Array<{ title: string; lead?: string; items: Item[] }> = [
  {
    title: s.credits.groups.game.title,
    lead: s.credits.groups.game.lead,
    items: [
      {
        name: 'Dungeon Crawl Stone Soup',
        url: 'https://github.com/crawl/crawl',
        meta: 'GPL v2 or later · © 1997–2025 Linley Henzell, the dev team and contributors',
      },
    ],
  },
  {
    title: s.credits.groups.builtWith.title,
    items: [
      { name: 'Unity', url: 'https://unity.com', note: s.credits.notes.unity },
      { name: 'Astro', url: 'https://astro.build', note: s.credits.notes.astro },
      { name: 'Tailwind CSS', url: 'https://tailwindcss.com', note: s.credits.notes.tailwind },
      { name: 'ffmpeg', url: 'https://ffmpeg.org', note: s.credits.notes.ffmpeg },
    ],
  },
  {
    title: s.credits.groups.typefaces.title,
    lead: s.credits.groups.typefaces.lead,
    items: [
      {
        name: 'Iosevka',
        url: 'https://typeof.net/Iosevka/',
        meta: 'SIL OFL 1.1 · © Renzhi Li',
        note: s.credits.notes.iosevka,
      },
      {
        name: 'Manrope',
        url: 'https://github.com/sharanda/manrope',
        meta: 'SIL OFL 1.1 · © The Manrope Project Authors',
        note: s.credits.notes.manrope,
      },
    ],
  },
  {
    title: s.credits.groups.hosting.title,
    items: [
      {
        name: 'GitHub Pages',
        url: 'https://pages.github.com',
        note: s.credits.notes.pages,
      },
    ],
  },
];
---

<Base
  lang={lang}
  path="/credits"
  title={`${s.credits.title} — DCSS 3D`}
  description={s.credits.description}
>
  <section class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <h1
      class="text-[clamp(1.6rem,1.2rem+1.6vw,2.25rem)] font-semibold tracking-tight"
    >
      {s.credits.title}
    </h1>
    <p class="mt-4 max-w-[54ch] text-[1.0625rem] leading-relaxed text-ink-dim">
      {s.credits.lead}
    </p>

    <div class="mt-12 flex max-w-[62ch] flex-col gap-12">
      {
        groups.map((group) => (
          <section>
            <h2 class="font-mono text-xs tracking-wide text-ink-dim uppercase">
              {group.title}
            </h2>

            {group.lead && (
              <p class="mt-3 leading-relaxed text-ink-dim">{group.lead}</p>
            )}

            <ul class="mt-4">
              {group.items.map((item) => (
                <li class="border-t border-rule/30 py-3">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ink underline decoration-rule underline-offset-4 transition-colors hover:decoration-ink"
                  >
                    {item.name}
                  </a>
                  {item.note && <span class="text-ink-dim"> — {item.note}</span>}
                  {item.meta && (
                    <span class="mt-1 block font-mono text-xs text-ink-dim">
                      {item.meta}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p
      class="mt-14 max-w-[62ch] border-t border-rule/30 pt-6 text-sm leading-relaxed text-ink-dim"
    >
      {s.credits.licences.before}
      <span class="font-mono text-xs">vendor/licenses/</span>{s.credits.licences.after}
    </p>
  </section>
</Base>
